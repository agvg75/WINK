# WINK repo = the app (staged/) + build/release tooling only.
# Ignore everything at the repo root by default, then re-include the keepers.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/WINK_README.md
!/BUILD_APP_UPDATE.ps1
!/BUILD_INSTALLER.ps1
!/build_ultimate_manual.py
!/staged/
!/installer/
!/.github/

# Within the kept folders, still drop caches and build junk (matches anywhere).
__pycache__/
*.pyc
*.pyo
*.zip
.venv/
venv/
*.bak
*.tmp
~$*
.DS_Store
Thumbs.db

# SECRETS. tokens.json holds the student access tokens for the help endpoint,
# and the ledger holds real student questions. Neither belongs in a public
# repository, and a token committed once stays in the history after deletion.
# tokens.example.json IS tracked - it is the template with no real values.
staged/server/tokens.json
staged/server/*.sqlite
staged/server/wink_ledger*

# Local Claude Code permissions. Machine-specific and not part of the app;
# settings.json (shared, if one is ever added) is NOT ignored.
staged/.claude/settings.local.json

# Large non-runtime source assets and locally generated docs.
staged/resources/*.tif
staged/resources/*_print_source.*
staged/docs/*_Definitive_Manual_v*.docx

# Test-run artefacts whose content is deterministic but whose clock is not.
# Everything else under tests/*/results/ stays tracked on purpose: those
# outputs ARE the regression signal, and a diff there means behaviour moved.
# These two only ever differ by a timestamp or a duration, so tracking them
# guarantees a dirty tree after every test run - which then gets swept into
# unrelated commits by `git add -A staged/`.
staged/tests/**/timing_report.json
staged/tests/**/decision_transparency.json
